/**
 * @file w25q128.c
 * @brief W25Q系列SPI Flash驱动实现
 * @note  便于移植到不同平台，只需实现底层SPI接口
 */

#include "w25q128.h"
#include <string.h>

/* ===== 全局变量 ===== */
static w25q_config_t g_w25q_config;
static uint32_t g_flash_size = 0;

/* ===== 内部辅助函数 ===== */

/**
 * @brief 读取Flash ID (制造商ID + 设备ID)
 * @return 制造商ID << 8 | 设备ID
 */
static inline uint16_t flash_read_id_raw(void) {
    w25q_platform_cs_select(1);
    w25q_platform_spi_transfer(W25Q_READ_ID);
    uint8_t manuf_id = w25q_platform_spi_transfer(0xFF);
    uint8_t device_id = w25q_platform_spi_transfer(0xFF);
    w25q_platform_cs_select(0);
    return (manuf_id << 8) | device_id;
}

/* ===== 通用驱动接口实现 ===== */

/**
 * @brief  初始化W25Q Flash
 */
int w25q_init(w25q_config_t* config) {
    if (config == NULL) {
        return -1;
    }

    // 保存配置
    memcpy(&g_w25q_config, config, sizeof(w25q_config_t));

    // CS默认为高电平(未选中)
    w25q_platform_cs_select(0);

    // 等待Flash上电稳定
    w25q_platform_delay_ms(100);

    return 0;
}

/**
 * @brief  读取Flash ID (制造商ID + 设备ID)
 */
uint16_t w25q_read_id(void) {
    return flash_read_id_raw();
}

/**
 * @brief  读取JEDEC ID并识别芯片
 */
uint32_t w25q_read_jedec_id(w25q_info_t* info) {
    w25q_platform_cs_select(1);
    w25q_platform_spi_transfer(W25Q_READ_JEDEC_ID);

    uint8_t manuf_id = w25q_platform_spi_transfer(0xFF);
    uint8_t mem_type = w25q_platform_spi_transfer(0xFF);
    uint8_t capacity = w25q_platform_spi_transfer(0xFF);

    w25q_platform_cs_select(0);

    // 填充info结构体
    if (info != NULL) {
        info->manufacturer_id = manuf_id;
        info->memory_type = mem_type;
        info->capacity_code = capacity;
        info->flash_size = 0;
        info->chip_name[0] = '\0';
    }

    // 根据容量字节识别芯片
    uint32_t size = 0;
    const char* chip_name = "Unknown";

    // Winbond (0xEF) 系列
    if (manuf_id == 0xEF && mem_type == 0x40) {
        switch (capacity) {
            case 0x10: size = 64 * 1024; chip_name = "W25Q64 (8MB)"; break;
            case 0x11: size = 128 * 1024; chip_name = "W25Q128 (16MB)"; break;
            case 0x12: size = 256 * 1024; chip_name = "W25Q256 (32MB)"; break;
            case 0x13: size = 512 * 1024; chip_name = "W25Q512 (64MB)"; break;
            case 0x14: size = 1024 * 1024; chip_name = "W25Q01 (128MB)"; break;
            case 0x15: size = 2048 * 1024; chip_name = "W25Q02 (256MB)"; break;
            case 0x16: size = 4096 * 1024; chip_name = "W25Q04 (512MB)"; break;
            case 0x17: size = 8192 * 1024; chip_name = "W25Q08 (1GB)"; break;
            case 0x18: size = 16 * 1024 * 1024; chip_name = "W25Q128 (16MB)"; break;
        }
    }
    // MXIC (0xC2)
    else if (manuf_id == 0xC2) {
        switch (capacity) {
            case 0x16: size = 4096 * 1024; chip_name = "MX25L04 (512MB)"; break;
            case 0x17: size = 8192 * 1024; chip_name = "MX25L08 (1GB)"; break;
            case 0x18: size = 16 * 1024 * 1024; chip_name = "MX25L16 (2GB)"; break;
        }
    }
    // Atmel (0x1F)
    else if (manuf_id == 0x1F) {
        switch (capacity) {
            case 0x18: size = 16 * 1024 * 1024; chip_name = "AT25QL128 (16MB)"; break;
        }
    }

    if (info != NULL) {
        info->flash_size = size;
        strncpy(info->chip_name, chip_name, sizeof(info->chip_name) - 1);
    }

    g_flash_size = size;
    return size;
}

/**
 * @brief  读取唯一ID (64位)
 */
void w25q_read_unique_id(uint8_t uid[8]) {
    w25q_platform_cs_select(1);
    w25q_platform_spi_transfer(W25Q_READ_UNIQUE_ID);
    w25q_platform_spi_transfer(0x00);  // Dummy
    w25q_platform_spi_transfer(0x00);
    w25q_platform_spi_transfer(0x00);
    w25q_platform_spi_transfer(0x00);

    for (int i = 0; i < 8; i++) {
        uid[i] = w25q_platform_spi_transfer(0xFF);
    }

    w25q_platform_cs_select(0);
}

/**
 * @brief  读取状态寄存器
 */
uint8_t w25q_read_status(void) {
    w25q_platform_cs_select(1);
    w25q_platform_spi_transfer(W25Q_READ_STATUS_REG);
    uint8_t status = w25q_platform_spi_transfer(0xFF);
    w25q_platform_cs_select(0);
    return status;
}

/**
 * @brief  等待Flash就绪
 */
int w25q_wait_ready(uint32_t timeout_ms) {
    uint32_t start = w25q_platform_get_millis();
    uint8_t status;

    do {
        w25q_platform_cs_select(1);
        w25q_platform_spi_transfer(W25Q_READ_STATUS_REG);
        status = w25q_platform_spi_transfer(0xFF);
        w25q_platform_cs_select(0);

        if (!(status & W25Q_STATUS_BUSY)) {
            return 0;  // 就绪
        }

        if (w25q_platform_get_millis() - start > timeout_ms) {
            return -1;  // 超时
        }

        w25q_platform_delay_ms(1);

    } while (1);
}

/**
 * @brief  写使能
 */
void w25q_write_enable(void) {
    w25q_platform_cs_select(1);
    w25q_platform_spi_transfer(W25Q_WRITE_ENABLE);
    w25q_platform_cs_select(0);
}

/**
 * @brief  写禁能
 */
void w25q_write_disable(void) {
    w25q_platform_cs_select(1);
    w25q_platform_spi_transfer(W25Q_WRITE_DISABLE);
    w25q_platform_cs_select(0);
}

/**
 * @brief  读取数据
 */
void w25q_read(uint32_t addr, uint8_t* buf, uint32_t len) {
    w25q_platform_cs_select(1);

    w25q_platform_spi_transfer(W25Q_READ_DATA);
    w25q_platform_spi_transfer((addr >> 16) & 0xFF);
    w25q_platform_spi_transfer((addr >> 8) & 0xFF);
    w25q_platform_spi_transfer(addr & 0xFF);

    for (uint32_t i = 0; i < len; i++) {
        buf[i] = w25q_platform_spi_transfer(0xFF);
    }

    w25q_platform_cs_select(0);
}

/**
 * @brief  快速读取数据
 */
void w25q_fast_read(uint32_t addr, uint8_t* buf, uint32_t len) {
    w25q_platform_cs_select(1);

    w25q_platform_spi_transfer(W25Q_FAST_READ);
    w25q_platform_spi_transfer((addr >> 16) & 0xFF);
    w25q_platform_spi_transfer((addr >> 8) & 0xFF);
    w25q_platform_spi_transfer(addr & 0xFF);
    w25q_platform_spi_transfer(0x00);  // Dummy字节

    for (uint32_t i = 0; i < len; i++) {
        buf[i] = w25q_platform_spi_transfer(0xFF);
    }

    w25q_platform_cs_select(0);
}

/**
 * @brief  页编程
 */
int w25q_page_program(uint32_t addr, const uint8_t* buf, uint32_t len) {
    if (len > W25Q_PAGE_SIZE) {
        len = W25Q_PAGE_SIZE;
    }

    w25q_write_enable();

    w25q_platform_cs_select(1);

    w25q_platform_spi_transfer(W25Q_PAGE_PROGRAM);
    w25q_platform_spi_transfer((addr >> 16) & 0xFF);
    w25q_platform_spi_transfer((addr >> 8) & 0xFF);
    w25q_platform_spi_transfer(addr & 0xFF);

    for (uint32_t i = 0; i < len; i++) {
        w25q_platform_spi_transfer(buf[i]);
    }

    w25q_platform_cs_select(0);

    return w25q_wait_ready(5000);
}

/**
 * @brief  写入数据 (自动处理页边界)
 */
int w25q_write(uint32_t addr, const uint8_t* buf, uint32_t len) {
    uint32_t offset = 0;
    uint32_t current_addr = addr;

    while (offset < len) {
        uint32_t page_space = W25Q_PAGE_SIZE - (current_addr % W25Q_PAGE_SIZE);
        uint32_t write_len = (len - offset) < page_space ? (len - offset) : page_space;

        if (w25q_page_program(current_addr, buf + offset, write_len) != 0) {
            return -1;
        }

        offset += write_len;
        current_addr += write_len;
    }

    return 0;
}

/**
 * @brief  扇区擦除 (4KB)
 */
int w25q_sector_erase(uint32_t addr) {
    w25q_write_enable();

    w25q_platform_cs_select(1);

    w25q_platform_spi_transfer(W25Q_SECTOR_ERASE);
    w25q_platform_spi_transfer((addr >> 16) & 0xFF);
    w25q_platform_spi_transfer((addr >> 8) & 0xFF);
    w25q_platform_spi_transfer(addr & 0xFF);

    w25q_platform_cs_select(0);

    return w25q_wait_ready(5000);
}

/**
 * @brief  32KB块擦除
 */
int w25q_block32_erase(uint32_t addr) {
    w25q_write_enable();

    w25q_platform_cs_select(1);

    w25q_platform_spi_transfer(W25Q_BLOCK_32K_ERASE);
    w25q_platform_spi_transfer((addr >> 16) & 0xFF);
    w25q_platform_spi_transfer((addr >> 8) & 0xFF);
    w25q_platform_spi_transfer(addr & 0xFF);

    w25q_platform_cs_select(0);

    return w25q_wait_ready(10000);
}

/**
 * @brief  64KB块擦除
 */
int w25q_block64_erase(uint32_t addr) {
    w25q_write_enable();

    w25q_platform_cs_select(1);

    w25q_platform_spi_transfer(W25Q_BLOCK_64K_ERASE);
    w25q_platform_spi_transfer((addr >> 16) & 0xFF);
    w25q_platform_spi_transfer((addr >> 8) & 0xFF);
    w25q_platform_spi_transfer(addr & 0xFF);

    w25q_platform_cs_select(0);

    return w25q_wait_ready(10000);
}

/**
 * @brief  芯片全片擦除
 */
int w25q_chip_erase(void) {
    w25q_write_enable();

    w25q_platform_cs_select(1);
    w25q_platform_spi_transfer(W25Q_CHIP_ERASE);
    w25q_platform_cs_select(0);

    // 全片擦除需要更长时间
    return w25q_wait_ready(60000);  // 60秒超时
}

/**
 * @brief  擦除后写入数据 (先擦除再写入)
 */
int w25q_erase_and_write(uint32_t addr, const uint8_t* buf, uint32_t len) {
    uint32_t start_sector = addr / W25Q_SECTOR_SIZE;
    uint32_t end_sector = (addr + len - 1) / W25Q_SECTOR_SIZE;

    // 擦除相关扇区
    for (uint32_t sector = start_sector; sector <= end_sector; sector++) {
        if (w25q_sector_erase(sector * W25Q_SECTOR_SIZE) != 0) {
            return -1;
        }
    }

    return w25q_write(addr, buf, len);
}

/**
 * @brief  设置SPI频率
 */
void w25q_set_spi_frequency(uint32_t hz) {
    g_w25q_config.spi_frequency = hz;
    // 需要平台支持才能动态修改
}

/**
 * @brief  获取检测到的Flash容量
 */
uint32_t w25q_get_flash_size(void) {
    return g_flash_size;
}
