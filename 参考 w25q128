/**
 * @file w25q128.h
 * @brief W25Q系列SPI Flash驱动头文件
 * @note  便于移植到不同平台，只需实现底层SPI接口
 *
 * 硬件连接:
 * - CS   -> 片选引脚
 * - CLK  -> 时钟引脚 (SCK)
 * - MOSI -> 主出从入 (SDO)
 * - MISO -> 主入从出 (SDI)
 */

#ifndef W25Q128_H
#define W25Q128_H

#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

/* ===== 配置宏: 需要根据不同平台实现 ===== */

/**
 * @brief 平台相关配置结构体
 * @note  使用时需要设置SPI句柄/引脚等信息
 */
typedef struct {
    void* spi_handle;      // SPI句柄 (平台相关)
    uint8_t pin_cs;        // 片选引脚
    uint32_t spi_frequency; // SPI频率
} w25q_config_t;

/* ===== W25Q系列指令定义 ===== */
#define W25Q_WRITE_ENABLE       0x06
#define W25Q_WRITE_DISABLE      0x04
#define W25Q_READ_STATUS_REG    0x05
#define W25Q_WRITE_STATUS_REG   0x01
#define W25Q_READ_DATA          0x03
#define W25Q_FAST_READ          0x0B
#define W25Q_PAGE_PROGRAM       0x02
#define W25Q_SECTOR_ERASE       0x20
#define W25Q_BLOCK_32K_ERASE    0x52
#define W25Q_BLOCK_64K_ERASE    0xD8
#define W25Q_CHIP_ERASE         0xC7
#define W25Q_READ_ID            0x9F
#define W25Q_READ_JEDEC_ID      0x9F
#define W25Q_READ_UNIQUE_ID     0x4B

/* ===== W25Q系列参数定义 ===== */
#define W25Q_PAGE_SIZE          256        // 页大小: 256字节
#define W25Q_SECTOR_SIZE        4096       // 扇区大小: 4KB
#define W25Q_BLOCK32_SIZE       (32 * 1024) // 32KB块
#define W25Q_BLOCK64_SIZE       (64 * 1024) // 64KB块

/* ===== 芯片容量定义 ===== */
typedef enum {
    W25Q_CHIP_UNKNOWN = 0,
    W25Q_CHIP_64   = 64 * 1024,    // 8Mbit / 1MB
    W25Q_CHIP_128  = 128 * 1024,   // 16Mbit / 2MB
    W25Q_CHIP_256  = 256 * 1024,   // 32Mbit / 4MB
    W25Q_CHIP_512  = 512 * 1024,   // 64Mbit / 8MB
    W25Q_CHIP_01   = 1024 * 1024,  // 128Mbit / 16MB
    W25Q_CHIP_02   = 2048 * 1024,  // 256Mbit / 32MB
    W25Q_CHIP_04   = 4096 * 1024,  // 512Mbit / 64MB
    W25Q_CHIP_08   = 8192 * 1024,  // 1Gbit / 128MB
    W25Q_CHIP_16   = 16 * 1024 * 1024 // 2Gbit / 256MB (W25Q128等)
} w25q_chip_size_t;

/* ===== 状态寄存器位定义 ===== */
#define W25Q_STATUS_BUSY        0x01  // BUSY位
#define W25Q_STATUS_WEL         0x02  // 写使能锁存位
#define W25Q_STATUS_BP0         0x04  // 块保护位0
#define W25Q_STATUS_BP1         0x08  // 块保护位1
#define W25Q_STATUS_BP2         0x10  // 块保护位2
#define W25Q_STATUS_SRWD        0x80  // 状态寄存器写保护

/* ===== 芯片信息结构体 ===== */
typedef struct {
    uint16_t manufacturer_id;   // 制造商ID
    uint8_t  device_id;         // 设备ID
    uint8_t  memory_type;       // 存储类型
    uint8_t  capacity_code;     // 容量代码
    uint32_t flash_size;        // Flash容量(字节)
    char     chip_name[32];     // 芯片名称
} w25q_info_t;

/* ===== 平台相关接口: 需要用户实现 ===== */

/**
 * @brief  平台相关: 延时函数 (毫秒)
 * @param  ms: 延时毫秒数
 */
void w25q_platform_delay_ms(uint32_t ms);

/**
 * @brief  平台相关: SPI片选控制
 * @param  select: 1=选中(拉低), 0=取消选中(拉高)
 */
void w25q_platform_cs_select(uint8_t select);

/**
 * @brief  平台相关: SPI传输一个字节
 * @param  data: 要发送的数据
 * @return 接收到的数据
 */
uint8_t w25q_platform_spi_transfer(uint8_t data);

/**
 * @brief  平台相关: 获取当前时间(毫秒)
 * @return 当前时间(毫秒)
 */
uint32_t w25q_platform_get_millis(void);

/* ===== 通用驱动接口 ===== */

/**
 * @brief  初始化W25Q Flash
 * @param  config: 配置结构体指针
 * @return 0=成功, -1=失败
 */
int w25q_init(w25q_config_t* config);

/**
 * @brief  读取Flash ID (制造商ID + 设备ID)
 * @return 制造商ID << 8 | 设备ID
 */
uint16_t w25q_read_id(void);

/**
 * @brief  读取JEDEC ID并识别芯片
 * @param  info: 芯片信息结构体指针
 * @return 芯片容量(字节), 0表示未知
 */
uint32_t w25q_read_jedec_id(w25q_info_t* info);

/**
 * @brief  读取唯一ID (64位)
 * @param  uid: 8字节的缓冲区
 */
void w25q_read_unique_id(uint8_t uid[8]);

/**
 * @brief  读取状态寄存器
 * @return 状态寄存器值
 */
uint8_t w25q_read_status(void);

/**
 * @brief  等待Flash就绪 (检查BUSY位)
 * @param  timeout_ms: 超时时间(毫秒)
 * @return 0=就绪, -1=超时
 */
int w25q_wait_ready(uint32_t timeout_ms);

/**
 * @brief  写使能
 */
void w25q_write_enable(void);

/**
 * @brief  写禁能
 */
void w25q_write_disable(void);

/**
 * @brief  读取数据
 * @param  addr: 起始地址
 * @param  buf: 数据缓冲区
 * @param  len: 读取长度
 */
void w25q_read(uint32_t addr, uint8_t* buf, uint32_t len);

/**
 * @brief  快速读取数据 (支持更高频率)
 * @param  addr: 起始地址
 * @param  buf: 数据缓冲区
 * @param  len: 读取长度
 */
void w25q_fast_read(uint32_t addr, uint8_t* buf, uint32_t len);

/**
 * @brief  页编程 (写入一页数据，最多256字节)
 * @param  addr: 起始地址 (必须页对齐，低8位为0)
 * @param  buf: 数据缓冲区
 * @param  len: 写入长度 (最多256字节)
 * @return 0=成功, -1=失败
 */
int w25q_page_program(uint32_t addr, const uint8_t* buf, uint32_t len);

/**
 * @brief  写入数据 (自动处理页边界)
 * @param  addr: 起始地址
 * @param  buf: 数据缓冲区
 * @param  len: 写入长度
 * @return 0=成功, -1=失败
 */
int w25q_write(uint32_t addr, const uint8_t* buf, uint32_t len);

/**
 * @brief  扇区擦除 (4KB)
 * @param  addr: 扇区地址 (必须4KB对齐)
 * @return 0=成功, -1=超时
 */
int w25q_sector_erase(uint32_t addr);

/**
 * @brief  32KB块擦除
 * @param  addr: 块地址 (必须32KB对齐)
 * @return 0=成功, -1=超时
 */
int w25q_block32_erase(uint32_t addr);

/**
 * @brief  64KB块擦除
 * @param  addr: 块地址 (必须64KB对齐)
 * @return 0=成功, -1=超时
 */
int w25q_block64_erase(uint32_t addr);

/**
 * @brief  芯片全片擦除
 * @return 0=成功, -1=超时
 */
int w25q_chip_erase(void);

/**
 * @brief  擦除后写入数据 (先擦除再写入)
 * @param  addr: 起始地址
 * @param  buf: 数据缓冲区
 * @param  len: 写入长度
 * @return 0=成功, -1=失败
 */
int w25q_erase_and_write(uint32_t addr, const uint8_t* buf, uint32_t len);

/**
 * @brief  设置SPI频率
 * @param  hz: 频率(Hz)
 * @note   需要平台支持才能动态修改
 */
void w25q_set_spi_frequency(uint32_t hz);

/**
 * @brief  获取检测到的Flash容量
 * @return Flash容量(字节)
 */
uint32_t w25q_get_flash_size(void);

#ifdef __cplusplus
}
#endif

#endif /* W25Q128_H */
